# 目标后端配置；业务服务尚未实现。与infra.env里的值保持一致。
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://vinyl_dev:replace-with-local-postgres-password@127.0.0.1:15432/vinyl
REDIS_URL=redis://:replace-with-local-redis-password@127.0.0.1:16379/0
AMQP_URL=amqp://vinyl_dev:replace-with-local-rabbit-password@127.0.0.1:15672/%2Fvinyl
CURSOR_SIGNING_KEY=replace-with-32-byte-random-value
COOKIE_SECURE=false
COOKIE_NAME=vinyl_session
MUSIC_PROVIDER_MODE=unconfigured
ALLOW_CATALOG_FIXTURES=true
