# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server-only Vinyl Search credentials. Never expose these as VITE_* variables.
DISCOGS_TOKEN=""
APPLE_MUSIC_DEVELOPER_TOKEN=""

# @meting/core uses its supported platform adapters for metadata search and does
# not require project-specific app keys. Discogs and Apple Music remain optional.
