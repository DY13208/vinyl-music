# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server-only Vinyl Search credentials. Never expose these as VITE_* variables.
DISCOGS_TOKEN=""
APPLE_MUSIC_DEVELOPER_TOKEN=""

# @meting/core uses its supported platform adapters for metadata search and does
# not require project-specific app keys. Discogs and Apple Music remain optional.

# Server-only self-hosted authentication
DATABASE_URL="postgres://user:password@localhost:5432/vinyl"
REDIS_URL="redis://localhost:6379"
AUTH_ORIGIN="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
